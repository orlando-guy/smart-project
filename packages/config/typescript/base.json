{
  "$schema": "https://schemastore.org",
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declarationMap": true,
    "declaration": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "target": "ESNext",
    "module": "ESNext"
  }
}
